<!DOCTYPE html>
<html lang="en">

<head>

    <!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>

<script>
    window.dataLayer = window.dataLayer || [];

    function gtag() {
        dataLayer.push(arguments);
    }

    gtag('js', new Date());

    gtag('config', 'G-T28B8YKEJM');
</script>


    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - ImageForge by BilvaSoftware
    </title>

    <meta name="description"
          content="ImageForge by BilvaSoftware - Fast and simple image conversion, compression, resizing, cropping and watermarking tools." />


    <!-- =====================================================
         BOOTSTRAP
         ===================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />


    <!-- =====================================================
         GLOBAL SITE CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <!-- =====================================================
         PAGE-SPECIFIC CSS
         ===================================================== -->

    @await RenderSectionAsync(
        "Styles",
        required: false
    )

</head>


<body>


    <!-- =====================================================
         NAVIGATION
         ===================================================== -->

    <header class="site-header">

        <nav class="navbar navbar-expand-lg">

            <div class="container">


                <!-- =================================================
                     LOGO
                     ================================================= -->

                <a class="navbar-brand brand-logo"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-icon">
                        ✦
                    </span>

                    <span>
                        ImageForge
                    </span>

                    <span class="brand-by">
                        by BilvaSoftware
                    </span>

                </a>


                <!-- =================================================
                     MOBILE MENU BUTTON
                     ================================================= -->
<button class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#mainNavigation"
        aria-controls="mainNavigation"
        aria-expanded="false"
        aria-label="Toggle navigation">
    <span class="hamburger">
        <span></span>
        <span></span>
        <span></span>
    </span>
</button>


                <!-- =================================================
                     NAVIGATION LINKS
                     ================================================= -->

                <div class="collapse navbar-collapse"
                     id="mainNavigation">

                    <ul class="navbar-nav ms-auto align-items-lg-center">


                        <!-- =========================================
                             CONVERTER
                             ========================================= -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                Converter

                            </a>

                        </li>


                        <!-- =========================================
                             COMPRESSOR
                             ========================================= -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Compressor"
                               asp-action="Index">

                                Compressor

                            </a>

                        </li>


                        <!-- =========================================
                             RESIZER
                             ========================================= -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Resizer"
                               asp-action="Index">

                                Resizer

                            </a>

                        </li>


                        <!-- =========================================
                             CROPPER
                             ========================================= -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Cropper"
                               asp-action="Index">

                                Cropper

                            </a>

                        </li>


                        <!-- =========================================
                             WATERMARK
                             ========================================= -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Watermark"
                               asp-action="Index">

                                Watermark

                            </a>

                        </li>


                        <!-- =========================================
                             ABOUT
                             ========================================= -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="About"
                               asp-action="Index">

                                About

                            </a>

                        </li>


                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <main>

        @RenderBody()

    </main>


    <!-- =====================================================
         FOOTER
         ===================================================== -->

    <footer class="site-footer">

        <div class="container">

            <div class="footer-content">


                <!-- =============================================
                     FOOTER BRAND
                     ============================================= -->

                <div>

                    <div class="footer-brand">

                        <span class="brand-icon">
                            ✦
                        </span>

                        <span>
                            ImageForge
                        </span>

                        <span class="brand-by">
                            by BilvaSoftware
                        </span>

                    </div>


                    <p>
                        Simple, fast and modern image tools.
                    </p>

                </div>


                <!-- =============================================
                     COPYRIGHT
                     ============================================= -->

                <div class="footer-copy">

                    © @DateTime.Now.Year BilvaSoftware.
                    All rights reserved.

                </div>


            </div>

        </div>

    </footer>


    <!-- =====================================================
         BOOTSTRAP JAVASCRIPT
         ===================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


    <!-- =====================================================
         GLOBAL SITE JAVASCRIPT
         ===================================================== -->

    <script src="~/js/site.js"
            asp-append-version="true"></script>


    <!-- =====================================================
         PAGE-SPECIFIC JAVASCRIPT
         ===================================================== -->

    @await RenderSectionAsync(
        "Scripts",
        required: false
    )


</body>

</html>